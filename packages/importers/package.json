{
  "name": "@paperdollkit/importers",
  "version": "2.0.0-alpha.0",
  "description": "External HD 2D asset importers (layered PSD via ag-psd, PNG/Albedo+Mask sets, auto-trimming, and HD demo pack generator)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@paperdollkit/core": "workspace:*",
    "ag-psd": "^28.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
